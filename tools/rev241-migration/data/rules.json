{
  "_comment": "Which numbers in the server's static data (everything under <data> except runtime/saves (the save migration owns it, with gear_loadouts/), runtime logs/bans/network/referrals, saves/ and cache*/) are ids of which type. json rules: file glob (relative to <data>, ** = any depth) + regex over the lenjson path ('[]' = array element, '{KEY}' = a numeric object key, '(str)' = a number inside a string). Every rule was checked against the loader that reads the field. Types are the manifest's.",
  "json": [
    {
      "glob": "items/item_info.json",
      "path": "^\\[\\]\\.id$",
      "type": "item"
    },
    {
      "glob": "items/presets.json",
      "path": "\\.item\\[\\]$",
      "type": "item"
    },
    {
      "glob": "items/spawns/**.json",
      "path": "^\\[\\]\\.id$",
      "type": "item"
    },
    {
      "glob": "items/weapon_types.json",
      "path": "(\\.attackAnimation|\\.defendAnimation|\\.renderAnimations\\[\\])$",
      "type": "seq"
    },
    {
      "glob": "items/weapon_types.json",
      "path": "(\\.attackSound|\\.equipSound)$",
      "type": "sound"
    },
    {
      "glob": "items/shield_types.json",
      "path": "\\.animationId$",
      "type": "seq"
    },
    {
      "glob": "npcs/combat/**.json",
      "path": "^\\[\\]\\.ids\\[\\]$",
      "type": "npc"
    },
    {
      "glob": "npcs/combat/**.json",
      "path": "^\\[\\]\\.[a-z]+_animation$",
      "type": "seq"
    },
    {
      "glob": "npcs/drops/eco/**.json",
      "path": "^\\[\\]\\.ids\\[\\]$",
      "type": "npc"
    },
    {
      "glob": "npcs/drops/pvp/**.json",
      "path": "^\\[\\]\\.ids\\[\\]$",
      "type": "npc"
    },
    {
      "glob": "npcs/drops/eco/**.json",
      "path": "^\\[\\]\\.[a-z]+_animation$",
      "type": "seq"
    },
    {
      "glob": "npcs/drops/eco/**.json",
      "path": "(\\.tables\\[\\]\\.items\\[\\]\\.id|\\.guaranteed\\[\\]\\.id)$",
      "type": "item"
    },
    {
      "glob": "npcs/drops/pvp/**.json",
      "path": "(\\.tables\\[\\]\\.items\\[\\]\\.id|\\.guaranteed\\[\\]\\.id)$",
      "type": "item"
    },
    {
      "glob": "npcs/drops/newDrops/*.json",
      "path": "^\\[\\]\\.itemid$",
      "type": "item"
    },
    {
      "glob": "npcs/spawns/**.json",
      "path": "^\\[\\]\\.id(\\(str\\))?$",
      "type": "npc"
    },
    {
      "glob": "objects/spawns/**.json",
      "path": "^\\[\\]\\.id$",
      "type": "obj"
    },
    {
      "glob": "pets/pet_recolor_exchange.json",
      "path": "(\\.baseItemId|\\.variants\\[\\]\\.itemId)$",
      "type": "item"
    },
    {
      "glob": "pets/pet_recolor_exchange.json",
      "path": "\\.variants\\[\\]\\.npcId$",
      "type": "npc"
    },
    {
      "glob": "cfg/donator_deals.json",
      "path": "\\.deals\\[\\]\\.itemIds\\[\\]$",
      "type": "item"
    },
    {
      "glob": "cfg/referral_promo.json",
      "path": "\\.prizeItems\\[\\]\\.id$",
      "type": "item"
    },
    {
      "glob": "donation_deals/*.json",
      "path": "\\.deals\\[\\]\\.item\\.id$",
      "type": "item"
    },
    {
      "glob": "economy/item_classification/*.json",
      "path": "^\\[\\]\\.id$",
      "type": "item"
    },
    {
      "glob": "brimstone_chest.json",
      "path": "^\\.items\\[\\]\\.id$",
      "type": "item"
    },
    {
      "glob": "teleport_previews.json",
      "path": "^\\.[^.]+\\.model$",
      "type": "model"
    },
    {
      "glob": "teleport_previews.json",
      "path": "^\\.[^.]+\\.anim$",
      "type": "seq"
    },
    {
      "glob": "runtime/donation_deals/*.json",
      "path": "(\\.deals\\[\\]\\.item\\.id|\\.tiers\\[\\]\\.items\\[\\]\\.id)$",
      "type": "item"
    }
  ],
  "yaml": [
    {
      "glob": "shops/*.yaml",
      "key": "id",
      "under": "defaultStock",
      "type": "item"
    }
  ],
  "filenames": [
    {
      "glob": "npcs/drops/newDrops/*.json",
      "type": "npc"
    },
    {
      "glob": "item_icons/*.png",
      "type": "item"
    }
  ],
  "skip": [
    "runtime/saves",
    "runtime/logs",
    "runtime/network",
    "runtime/bans",
    "runtime/referrals",
    "saves",
    "cache",
    "cache241",
    "gear_loadouts",
    "items.json",
    "items-complete.json",
    "monsters-complete.json",
    "npcs-summary.json",
    "xteas.json",
    "region_keys.json"
  ],
  "dropIds": {
    "_why": "Reviewed 2026-10-25: these npc ids were undefined in our live 231 cache, so their entries were dead, but they are Jagex npcs in rev 241 and the entries would attach custom combat / drops to them (e.g. the Nomad boss handler on 15087 = Fishing spot, combat-pet handlers whose classes no longer exist on Rainbow crab / Gwyna / Ocean Man, custom drop tables on 15000/15003/15021 = Sailor-era npcs). Found by checking every rule-typed id: undefined in 231, defined in 241, not a remap target.",
    "npc": [
      15000,
      15001,
      15002,
      15003,
      15021,
      15087,
      15091,
      15092,
      15094,
      15095,
      15104,
      15105,
      15106,
      15107,
      15108,
      15109,
      15110,
      15111,
      15112,
      15113,
      15114,
      15115,
      15116,
      15117,
      15118,
      15119
    ]
  }
}
