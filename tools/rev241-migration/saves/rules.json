{
  "_comment": "Classification of save JSON paths that hold numbers in a colliding id range. Pattern = '<file group>|<path regex>' ('*' = any group). Kinds: item, npc, obj, varp, varbit, varp-index-array, packed-var-key, ignore. {id, amount} objects are items without a rule. Each rule was checked against the server code that writes the field (PlayerAttributes etc.).",
  "paths": {
    "players|\\$\\.petItemIdsObtained\\[\\]": "item",
    "players|\\$\\.varps\\[\\]": "varp-index-array",

    "*|.*\\.amount": "ignore",
    "players|\\$\\.[A-Za-z]+BestTime": "ignore",
    "players|\\$\\.savedConfigs\\.\\{key\\}": "ignore",
    "players|\\$\\.uniqueDrops\\.\\{key\\}": "ignore",
    "players|\\$\\.(PvmPoints|donatorPoints|reasonPoints|lifetimeWintertodtPoints|wintertodtstorePoints|perkTreeExperience)": "ignore",
    "players|\\$\\.(playTime|securityPin|magicShortbowAttacks|revenantKillcount)": "ignore",
    "players|\\$\\.(currentDailyTaskAmounts|startingDailyTaskAmounts)\\[\\]": "ignore",
    "players|\\$\\.slayerTaskPosition\\.[xyz]": "ignore",
    "players|\\$\\.soulWeapon\\.soulsHarvested": "ignore",
    "runtime/saves/scoreboard.json|\\$\\.weekly\\.users\\.[A-Z_]+\\.[^.]+": "ignore"
  },
  "keyPaths": {
    "players|\\$\\.uniqueDrops\\.\\{key\\}": "item",
    "players|\\$\\.weaponAutocastIds\\.\\{key\\}": "item",
    "players|\\$\\.savedConfigs\\.\\{key\\}": "packed-var-key"
  }
}
