import java.awt.*;
import java.awt.image.BufferedImage;

/**
 * Round 2 art for Karn Perks, interface 1151 (server: PerkHub): "Arcane Codex" -- a raspberry-crimson accent and rune
 * motifs. 25150 window (the main view's five panels painted), 25151/25152 the search field (158 x 16), 25153-25166 the
 * buttons at each size the window uses (SIZES, normal + hover).
 */
final class KarnArtPerks {

	private KarnArtPerks() {
	}

	static final Color ARCANE = new Color(0xb8325e), ARCANE_HI = new Color(0xf0a0c0);
	/** The stone button sizes in 1151 (w, h), in sprite order from 25153 (hover = + 1). */
	static final int[][] SIZES = { { 116, 18 }, { 122, 20 }, { 124, 21 }, { 160, 21 }, { 74, 21 }, { 78, 21 }, { 94, 21 } };

	static void panel(Graphics2D g, int rootX, int rootY, int w, int h, String rune) {
		int x = rootX - 14, y = rootY - 9;
		KarnArt.plate(g, x, y, w, h, new Color(0x201419), new Color(0x120b0e), KarnArt.LINE);
		KarnArt.hairline(g, x + 4, x + w - 4, y, ARCANE, 170);
		if (rune != null) { // a faint rune watermark in the panel's corner
			BufferedImage r = KarnArt.icon(rune, 30, new Color(0x3a1a26), new Color(0x220e16));
			g.drawImage(r, x + w - 36, y + h - 36, null);
		}
	}

	static void paint() throws Exception {
		BufferedImage im = KarnArt.window(487, 306, 31, ARCANE, 1151);
		Graphics2D g = KarnArt.g(im);
		KarnArt.heading(g, "Perks", 243.5, 23, 17f, new Color(0xffd6e4), new Color(0xd88aa8));
		BufferedImage rune = KarnArt.icon("rune", 15, ARCANE_HI, ARCANE);
		g.drawImage(rune, 203, 9, null);
		g.drawImage(rune, 270, 9, null);
		panel(g, 24, 62, 196, 60, null);    // categories
		panel(g, 24, 126, 196, 62, null);   // active perks
		panel(g, 24, 192, 196, 113, "book");  // loadouts
		panel(g, 226, 62, 262, 128, null);  // the perk list
		panel(g, 226, 194, 262, 111, "rune"); // details
		g.dispose();
		MakeKarnUi2.save(25150, im);
		MakeKarnUi2.save(25151, field(158, 16, false));
		MakeKarnUi2.save(25152, field(158, 16, true));
		for (int i = 0; i < SIZES.length; i++)
			for (int hover = 0; hover < 2; hover++)
				MakeKarnUi2.save(25153 + i * 2 + hover, button(SIZES[i][0], SIZES[i][1], hover == 1));
	}

	/** An arcane button: raspberry crimson, gold rim, a faint violet sheen. */
	static BufferedImage button(int w, int h, boolean hover) {
		BufferedImage im = KarnArt.image(w, h);
		Graphics2D g = KarnArt.g(im);
		double c = Math.min(4, h / 5.0);
		g.setColor(KarnArt.LINE_DK);
		g.fill(KarnArt.chamfer(0, 0, w, h, c + 0.5));
		g.setPaint(new GradientPaint(0, 1, hover ? new Color(0xd84a7a) : new Color(0xae2e58), 0, h - 1, hover ? new Color(0x7a1a3c) : new Color(0x5a1028)));
		g.fill(KarnArt.chamfer(1, 1, w - 2, h - 2, c));
		g.setColor(hover ? KarnArt.GOLD_HI : KarnArt.GOLD);
		g.draw(KarnArt.chamfer(1.5, 1.5, w - 3, h - 3, c - 0.5));
		g.setColor(new Color(255, 220, 235, hover ? 110 : 70));
		g.fillRect((int) c + 2, 2, (int) (w - 2 * c - 4), 1);
		g.dispose();
		return im;
	}

	static BufferedImage field(int w, int h, boolean hover) {
		BufferedImage im = KarnArt.image(w, h);
		Graphics2D g = KarnArt.g(im);
		KarnArt.well(g, 0, 0, w, h, hover ? new Color(0x1c1216) : new Color(0x120c0e), hover ? ARCANE : KarnArt.LINE_HI);
		g.dispose();
		KarnArt.stamp(im, KarnArt.icon("search", 11, hover ? ARCANE_HI : new Color(0xe08aa8), ARCANE), 3, 3);
		return im;
	}
}
