# Caddy automatically provisions and renews Let's Encrypt certs for any
# domain here — requires every domain below to already resolve (via DNS A
# records) to this VPS's public IP before the stack starts, or the ACME
# HTTP-01 challenge will fail and it'll retry/backoff.
#
# Service names (website_client, website_api) resolve via the Swarm
# overlay network — no IPs or ports needed, Docker's embedded DNS handles it.
#
# Karn domain move (beta 2026-11-18): BETA_DOMAIN / BETA_API_DOMAIN are now
# karnps.com / api.karnps.com. The old Zelus domains stay on this proxy:
#   - the old website redirects (301) to the new one, path and query kept;
#   - the old API host keeps SERVING (not redirecting) the API, because Tebex,
#     NOWPayments and the vote topsites POST their webhooks to the URL they were
#     registered with, and webhook senders don't reliably follow redirects.
#     Re-register those callbacks on api.karnps.com, then retire this block.

{$BETA_DOMAIN} {
	reverse_proxy website_client:80
}

www.{$BETA_DOMAIN} {
	redir https://{$BETA_DOMAIN}{uri} permanent
}

{$BETA_API_DOMAIN} {
	reverse_proxy website_api:8000
}

{$LEGACY_DOMAIN:zelusrsps.com}, www.{$LEGACY_DOMAIN:zelusrsps.com} {
	redir https://{$BETA_DOMAIN}{uri} permanent
}

{$LEGACY_API_DOMAIN:api.zelusrsps.com} {
	reverse_proxy website_api:8000
}
