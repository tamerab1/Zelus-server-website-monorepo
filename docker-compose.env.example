DB_SQL_ROOT_PASSWORD=CHANGE_ME
DB_SQL_USER=CHANGE_ME
DB_SQL_USER_PASSWORD=CHANGE_ME
MONGO_ROOT_USER=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
IMAGE_REGISTRY=ghcr.io/CHANGE_ME/kronos

# ── Website (website_api / website_client / reverse_proxy) ────────────────
# Password for the dedicated 'website_api' MariaDB user, created on first
# db_sql boot by docker/db_sql/docker-entrypoint-initdb.d/init_website.sh.
# Grants: full access to zelusrsps_db, read-only SELECT on reason (hiscores).
WEBSITE_DB_PASSWORD=CHANGE_ME

# Public domains the Caddy reverse proxy requests Let's Encrypt certs for.
# Must already have DNS A records pointing at this host's public IP before
# the stack starts, or cert issuance will fail. No leading "https://".
BETA_DOMAIN=beta.CHANGE_ME.com
BETA_API_DOMAIN=api.beta.CHANGE_ME.com

# Optional — leave blank to disable each feature rather than fake credentials.
# Cloudflare Turnstile (CAPTCHA): blank = widget skipped entirely.
TURNSTILE_SECRET_KEY=
# SMTP (email verification): blank = verification links print to API logs
# instead of emailing — fine for a small beta group you can hand links to.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Stripe / PayPal: leave blank unless you actually want beta testers able to
# pay. Use *test*/*sandbox* keys only — never live keys for a beta.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Tebex: signature secret from Developers > Webhooks > Endpoints on the Tebex
# creator panel, for the endpoint pointed at /api/webhooks/tebex. Leave blank
# to disable -- the endpoint 500s on every ping until this is set.
TEBEX_SECRET=
# NOWPayments (crypto checkout): API key + IPN Secret from Store Settings on
# the NOWPayments dashboard (two separate values). Leave blank to disable --
# /api/checkout/crypto 503s until NOWPAYMENTS_API_KEY is set.
# (No separate API_BASE_URL var needed here -- docker-compose-prod.yml derives
# it directly from BETA_API_DOMAIN above.)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
